# Environment Variables
# Copy file ini menjadi .env dan isi dengan nilai yang sesuai

# Database URL (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Contoh untuk Supabase: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# Contoh untuk Neon:     postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
